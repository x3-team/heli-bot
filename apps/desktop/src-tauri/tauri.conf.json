{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heli bot",
  "version": "0.1.0",
  "identifier": "ru.getheli.bot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Heli bot",
        "width": 1120,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https://github.com https:; img-src 'self' data: blob:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/x3-team/heli-bot/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzMUExMkQ0MEE3QkFDOEYKUldTUHJIc0sxQklhazZ1ZTFDM2lxMFgzaTIvM1NsMVl2Tm54MlJYM0ozR2x2UmNoOGhaRHorbTQK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
