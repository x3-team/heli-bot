# Copy to the server (path from GitHub secret HELI_DEPLOY_ENV_FILE). Never commit real values.

# Required — name of the existing reverse-proxy Docker network on the shared host.
HELI_PROXY_NETWORK=

# Required — Postgres password for the dedicated Heli database container.
POSTGRES_PASSWORD=

# Required — app secrets (same names as local/server development).
JWT_SECRET=
TRAJECTORY_HASH_PEPPER=
HELI_API_KEY=
HELI_BASE_URL=https://getheli.ru/v1
# Models: gateway (foreign models via getheli) or ru (Cloud.ru, hosted in RF, no VPN).
HELI_MODELS=gateway
CLOUDRU_API_KEY=
# Optional, for yandex:... slugs in HELI_UPSTREAM_*.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Optional
VAULT_MASTER_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
DAILY_LIMIT_RUB=1000
DEFAULT_MONTHLY_LIMIT_RUB=1000
