# Copy to /opt/heli-bot/.env on the host (HELI_DEPLOY_ENV_FILE). Never commit real values.

APP_ENV=production
HOST=127.0.0.1
PORT=8001
DATABASE_URL=sqlite:////opt/heli-bot/var/heli.db

JWT_SECRET=
TRAJECTORY_HASH_PEPPER=
HELI_API_KEY=
HELI_BASE_URL=https://getheli.ru/v1

VAULT_MASTER_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
DAILY_LIMIT_RUB=1000
DEFAULT_MONTHLY_LIMIT_RUB=1000

# Agent web search. Without a key the agent still opens pages, and search falls
# back to Wikipedia. Yandex Search API (Yandex Cloud): API key + folder id.
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=
# Or Tavily instead of Yandex.
TAVILY_API_KEY=

# Heli's own browser on this server (the «Компьютер агента» panel). Deploy installs
# Playwright Chromium when this is 1. Each open account takes ~150-300 MB on top of ~370 MB.
CLOUD_BROWSER_ENABLED=0
CLOUD_BROWSER_MAX=2
# Files between the cloud computer and the user's PC (Загрузки/Heli). Per file / per account, MB.
HELI_FILES_MAX_MB=25
HELI_FILES_ACCOUNT_MB=200

# Paid beta sign-up. Admins (comma-separated) sign up without an invite and hand out invites and codes in Settings.
HELI_OPEN_ACCESS=0
HELI_INVITE_ONLY=1
HELI_ADMIN_EMAILS=
