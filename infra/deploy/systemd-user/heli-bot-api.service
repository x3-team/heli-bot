[Unit]
Description=Heli bot API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/server
EnvironmentFile=-%h/.env
ExecStart=%h/venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
Slice=helibot.slice

[Install]
WantedBy=default.target
