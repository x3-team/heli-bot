[Unit]
Description=Heli bot API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/server
EnvironmentFile=-%h/.env
Environment=PLAYWRIGHT_BROWSERS_PATH=%h/var/ms-playwright
Environment=CLOUD_BROWSER_PROFILES=%h/var/browser-profiles
Environment=CLOUD_BROWSER_LIBS=%h/var/chromium-libs
ExecStart=%h/venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
Slice=helibot.slice

[Install]
WantedBy=default.target
