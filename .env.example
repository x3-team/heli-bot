# Copy to .env for local docker compose. Never commit real values.
# HELI_API_KEY is read from the environment. On CI it is the GitHub Actions secret.

HELI_API_KEY=
HELI_BASE_URL=https://getheli.ru/v1
DATABASE_URL=postgresql+psycopg://heli:heli@localhost:5432/heli
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=
TRAJECTORY_HASH_PEPPER=
VAULT_MASTER_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_ENV=development
PORT=8000
DAILY_LIMIT_RUB=1000
DEFAULT_MONTHLY_LIMIT_RUB=1000

# Agent web search. Without a key the agent still opens pages, and search falls
# back to Wikipedia. Yandex Search API (Yandex Cloud): API key + folder id.
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=
# Or Tavily instead of Yandex.
TAVILY_API_KEY=
# PC hands: agent clicks and types on the user's own Windows. Off in v0.1.
HELI_PC_HANDS=false
