# Copy to .env for local docker compose. Never commit real values.
# HELI_API_KEY is read from the environment. On CI it is the GitHub Actions secret.

HELI_API_KEY=
HELI_BASE_URL=https://getheli.ru/v1
DATABASE_URL=postgresql+psycopg://heli:heli@localhost:5432/heli
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=
TRAJECTORY_HASH_PEPPER=
VAULT_MASTER_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_ENV=development
PORT=8000
DAILY_LIMIT_RUB=1000
DEFAULT_MONTHLY_LIMIT_RUB=1000

# Agent web search: hybrid, no paid key needed (README, «Доступ в интернет»).
# Index official help once a day in the background.
HELI_DOCS_CRAWL=1
HELI_DOCS_CRAWL_PER_SITE=100
# Yandex Search API: used only with HELI_SEARCH_YANDEX=1.
HELI_SEARCH_YANDEX=0
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=
# Tavily: used only with HELI_SEARCH_TAVILY=1.
HELI_SEARCH_TAVILY=0
TAVILY_API_KEY=
# Own SearXNG instance (API-backed engines only).
HELI_SEARXNG_URL=
# ya.ru / go.mail.ru result pages in the cloud browser: their robots.txt forbids it, keep 0.
HELI_SEARCH_BROWSER_SERP=0
# PC hands: agent clicks and types on the user's own Windows. Off in v0.1.
HELI_PC_HANDS=false
# Bot plans and wallet: new sign-ups start on the trial week (server/app/billing.py).
HELI_BILLING=0
